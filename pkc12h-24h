/* 4. 创建自动同步触发器 - sportinfo */
DROP TRIGGER IF EXISTS "sync_time_24h";
CREATE TRIGGER "sync_time_24h" AFTER INSERT ON "sportinfo" FOR EACH ROW
BEGIN
    UPDATE "sportinfo" SET "time" = (
        SELECT 
            substr(c, 1, 11) || 
            printf('%02d', (CASE 
                WHEN NEW."time" LIKE '%下午%' OR NEW."time" LIKE '%PM%' THEN (CAST(substr(c, 12, instr(substr(c, 12), ':')-1) AS INT) % 12) + 12
                WHEN NEW."time" LIKE '%上午%' OR NEW."time" LIKE '%AM%' THEN (CAST(substr(c, 12, instr(substr(c, 12), ':')-1) AS INT) % 12)
                ELSE CAST(substr(c, 12, 2) AS INT)
            END)) || 
            substr(c, 11 + instr(substr(c, 12), ':'))
        FROM (SELECT replace(replace(replace(replace(trim(NEW."time"), '上午', ' '), '下午', ' '), 'AM', ' '), 'PM', ' ') AS c)
    ) WHERE rowid = NEW.rowid;
END;

