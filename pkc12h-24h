/* 1. 基础清理 */
UPDATE "sportinfo" SET "time" = REPLACE("time", '/', '-');
UPDATE "huihualog" SET "time" = REPLACE("time", '/', '-');

/* 2. 修复旧数据 - sportinfo (小时翻转) */
UPDATE "sportinfo"
SET "time" = (
    SELECT 
        substr(c, 1, 11) || 
        printf('%02d', (CASE 
            WHEN "time" LIKE '%下午%' OR "time" LIKE '%PM%' THEN (CAST(substr(c, 12, instr(substr(c, 12), ':')-1) AS INT) % 12) + 12
            WHEN "time" LIKE '%上午%' OR "time" LIKE '%AM%' THEN (CAST(substr(c, 12, instr(substr(c, 12), ':')-1) AS INT) % 12)
            ELSE CAST(substr(c, 12, 2) AS INT)
        END)) || 
        substr(c, 11 + instr(substr(c, 12), ':'))
    FROM (SELECT replace(replace(replace(replace(trim("time"), '上午', ' '), '下午', ' '), 'AM', ' '), 'PM', ' ') AS c)
)
WHERE "time" LIKE '%午%' OR "time" LIKE '%M%';

